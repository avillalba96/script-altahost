####################
# sanoid.conf file #
####################

# Snapshot policy for Proxmox VM datasets under rpool/data
[rpool/data]
        use_template = proxbase
        recursive = yes
        process_children_only = yes

#############################
# templates below this line #
#############################

[template_proxbase]
        frequently = 0
        # Keep this many hourly snapshots
        hourly = 6
        # Keep this many daily snapshots
        daily = 7
        # Keep this many monthly snapshots
        monthly = 0
        # Keep this many yearly snapshots
        yearly = 0
        # create new snapshots
        autosnap = yes
        # prune old snapshots
        autoprune = yes
